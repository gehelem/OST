            },
            "crossaxis": {
                "type":"float",
                "label": "Cross-axis (px)",
                "order":"06",
                "value": 0,
                "format": "999.99",
                "hint": "displacement on the image axis orthogonal to RA; should stay near 0 (health signal: CD slip / tilt)"
            }
