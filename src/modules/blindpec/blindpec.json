    "calParams": {
        "devcat": "Calibration",
        "group": "",
        "order":"Parameters100",
        "permission": 2,
        "hasprofile":true,
        "label": "Calibration Parameters",
        "e": {
            "chardur": {
                "type":"float",
                "autoupdate":true,
                "directedit":true,
                "label": "Characterization duration (s)",
                "order":"01",
                "value":60,
                "format": "99999.9",
                "min":5,
                "max":100000,
                "hint": "step 1: observe the free-run sidereal drift for this long (mount tracking, no pulses) to get the RA axis direction and rate. A rough value needs a few tens of s; a clean one needs >= one worm period"
            },
            "calpulse": {
                "type":"int",
                "autoupdate":true,
                "directedit":true,
                "label": "Gain-cal pulse (ms)",
                "order":"02",
                "value":800,
                "format": "9999",
                "hint": "step 2: W/E pulse length; must move the image by a clearly measurable amount"
            },
            "calsteps": {
                "type":"int",
                "autoupdate":true,
                "directedit":true,
                "label": "Gain-cal pulses per direction",
                "order":"03",
                "value":4,
                "format": "99",
                "min":2,
                "max":20,
                "hint": "step 2 sends this many W pulses and this many E pulses, alternating"
            }
        }
    },
    "pid": {
        "devcat": "Guiding",
        "group": "",
        "order":"Parameters150",
        "permission": 2,
        "hasprofile":true,
        "label": "Control law",
        "e": {
            "kp": {
                "type":"float",
                "autoupdate":true,
                "directedit":true,
                "label": "Kp",
                "order":"01",
                "value":0.6,
                "format": "9.999",
                "hint": "proportional gain on the residual (px -> px of correction)"
            },
            "ki": {
                "type":"float",
                "autoupdate":true,
                "directedit":true,
                "label": "Ki",
                "order":"02",
                "value":0.05,
                "format": "9.999",
                "hint": "integral gain (px.s). Nulls a steady offset a P-only law would leave; 0 = pure P"
            },
            "kd": {
                "type":"float",
                "autoupdate":true,
                "directedit":true,
                "label": "Kd",
                "order":"03",
                "value":0,
                "format": "9.999"
            }
        }
    },
    "guideParams": {
        "devcat": "Guiding",
        "group": "",
        "order":"Parameters200",
        "permission": 2,
        "rule":2,
        "hasprofile":true,
        "label": "Guide parameters",
        "e": {
            "pulsemin": {
                "type":"int",
                "autoupdate":true,
                "directedit":true,
                "label": "Min pulse (ms)",
                "order":"01",
                "value":20,
                "format": "9999"
            },
            "pulsemax": {
                "type":"int",
                "autoupdate":true,
                "directedit":true,
                "label": "Max pulse (ms)",
                "order":"02",
                "value":1500,
                "format": "9999"
            },
            "blankframes": {
                "type":"int",
                "autoupdate":true,
                "directedit":true,
                "label": "Blank frames after a pulse",
                "order":"04",
                "value":1,
                "format": "99",
                "min":0,
                "max":10,
                "hint": "frames measured but not corrected right after a pulse, to skip the mechanical transient"
            },
            "alphaV": {
                "type":"float",
                "autoupdate":true,
                "directedit":true,
                "label": "V adaptation gain",
                "order":"05",
                "value":0.02,
                "format": "9.9999",
                "min":0,
                "max":1,
                "hint": "online correction of the target rate V from the residual ramp. 0 = fixed V. Small = slow, stable"
            },
            "intmax": {
                "type":"float",
                "autoupdate":true,
                "directedit":true,
                "label": "Integral clamp (px)",
                "order":"05a",
                "value":50,
                "format": "999.9",
                "min":0,
                "max":5000,
                "hint": "anti-windup: the integral accumulator is clamped to this magnitude. 0 -> default 50"
            },
            "rmsOver": {
                "type":"int",
                "autoupdate":true,
                "directedit":true,
                "label": "RMS over x frames",
                "order":"06",
                "value":20,
                "format": "999",
                "min":2,
                "max":1000
            },
            "reanchorfrac": {
                "type":"float",
                "autoupdate":true,
                "directedit":true,
                "label": "Re-anchor fraction",
                "order":"07",
                "value":0.35,
                "format": "9.999",
                "min":0.05,
                "max":0.9,
                "hint": "re-drop the correlation anchor once the running shift exceeds this fraction of half the frame"
            },
            "maxsteppx": {
                "type":"float",
                "autoupdate":true,
                "directedit":true,
                "label": "Max step (px)",
                "order":"08",
                "value":40,
                "format": "9999.9",
                "hint": "reject a frame whose move since the last accepted one exceeds this (vibration / glitch)"
            },
            "minresponse": {
                "type":"float",
                "autoupdate":true,
                "directedit":true,
                "label": "Min correlation response",
                "order":"09",
                "value":0.10,
                "format": "9.999",
                "min":0,
                "max":1
            },
            "maxmatchfail": {
                "type":"int",
                "autoupdate":true,
                "directedit":true,
                "label": "Max consecutive bad frames",
                "order":"10",
                "value":10,
                "format": "999",
                "min":1,
                "max":1000,
                "hint": "guiding is aborted after this many untrusted frames in a row"
            },
            "ditherpixel": {
                "type":"int",
                "autoupdate":true,
                "directedit":true,
                "label": "Dither amplitude (px)",
                "order":"11",
                "value":5,
                "format": "99",
                "min":0,
                "max":50,
                "hint": "RA-only dither (DEC component of a sequencer dither request is a no-op here)"
            },
            "watchdog": {
                "type":"int",
                "autoupdate":true,
                "directedit":true,
                "label": "Hardware timeout (s)",
                "order":"12",
                "value":30,
                "format": "999",
                "min":0,
                "max":600,
                "hint": "abort if the camera or mount stops responding for this long. 0 disables"
            }
        }
