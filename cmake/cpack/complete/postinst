#!/bin/sh
set -e
#
# postinst for the "ostserver-complete" package (issue #229) - the
# beginner-friendly, self-contained alternative to "ostserver" (see
# cmake/cpack/DebianPackage.cmake's own header comment on why this is a
# SEPARATE, independent package rather than a layer on top of it:
# Conflicts/Replaces, not Depends - a single `apt install
# ./ostserver-complete.deb` must work standalone, no custom PPA/repo
# needed, just nginx from the standard distro archives).
#
# Everything up to the "--- nginx ---" marker below is deliberately kept
# identical to cmake/cpack/postinst (the plain "ostserver" package) -
# this package ships its own copy of the same binaries, so it needs the
# exact same service/working-directory/webroot setup on top of the
# nginx wiring. Not sourced/shared from one file: two small, fully
# readable standalone scripts beat an extra indirection for just these
# two consumers - keep them in sync by hand if one changes.

case "$1" in
    configure)
        # Prefer the username install-latest-complete.sh passes explicitly
        # (OST_INSTALL_USER, preserved through its own `sudo --preserve-env`
        # call) - $SUDO_USER is only reliable for a single, direct `sudo
        # <cmd>` and silently resolves to "root" under anything nested
        # (a root shell, `sudo -i`, a script already elevated calling
        # `sudo apt install` again from inside itself), confirmed 2026-10.
        INSTALL_USER="${OST_INSTALL_USER:-${SUDO_USER:-${USER:-root}}}"
        USER_HOME=$(getent passwd "${INSTALL_USER}" | cut -d: -f6)
        OST_DIR="${USER_HOME}/.ost"

        # Patch the service file with the actual user and working directory
        sed -i "s/^User=.*/User=${INSTALL_USER}/" /usr/lib/systemd/system/ostserver.service
        sed -i "s|^WorkingDirectory=.*|WorkingDirectory=${OST_DIR}|" /usr/lib/systemd/system/ostserver.service

        # Create working directory and set ownership
        mkdir -p "${OST_DIR}"
        chown "${INSTALL_USER}" "${OST_DIR}"

        # Create media directory and set ownership
        mkdir -p /var/lib/osterix/media
        chown -R "${INSTALL_USER}" /var/lib/osterix

        # Create default parms file if it does not exist yet - the
        # skeleton is shipped by CMake (share/ostserver/ostserver.parms.skel)
        # so this content lives in exactly one place in the repo.
        PARMS_FILE="${OST_DIR}/ostserver.parms"
        if [ ! -f "${PARMS_FILE}" ]; then
            cp /usr/share/ostserver/ostserver.parms.skel "${PARMS_FILE}"
            chown "${INSTALL_USER}" "${PARMS_FILE}"
        fi

        # --- nginx (Complete package only) ---
        #
        # Plain HTTP, no SSL by design (Gilles, 2026-10 packaging
        # discussion: "pas de SSL automatique pour le paquet tout-en-un"
        # - local-network use case; SSL stays an advanced/manual choice
        # for the plain "ostserver" package). Serves front-www/'s static
        # files (installed by CMake's own Complete component) plus the
        # same media webroot --webroot=/var/lib/osterix/media already
        # points at above - no WebSocket proxying needed at all, the
        # frontend connects directly to ws://host:9624 in its own
        # non-SSL mode (see front/core/index.js's deriveUrlsFromHost()).
        # Named after the FRONTEND being served ("pilost"), not the
        # backend package ("ostserver-complete") - Gilles: lets other
        # frontends coexist/be managed the same legible way later, e.g.
        # /etc/nginx/sites-enabled/osterix alongside this one.
        NGINX_SITE="/etc/nginx/sites-available/pilost"
        cat > "${NGINX_SITE}" << 'EOF'
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/pilost;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /ostmedia/ {
        alias /var/lib/osterix/media/;
        autoindex on;
    }

    # The Hugo site under documentation/ is built with baseURL set to
    # the real documentation.ostserver.fr (hugo.toml) - it is NOT
    # rebuilt with a different baseURL just for this local, subpath
    # mount (that would mean two parallel Hugo builds to keep in sync).
    # The Relearn theme emits root-relative links for everything except
    # the language switcher (href=/css/..., src=/js/..., and the
    # unquoted data-nav-id=/.../data-url=/... the nav sidebar/language
    # select use - Hugo's --minify drops attribute quotes wherever the
    # value has no whitespace) - these resolve against the domain root
    # instead of /documentation/ unless rewritten here. Confirmed by
    # extracting the real documentation_latest.tar.gz, 2026-10 - these
    # four attribute names plus the one inline search-index JS var
    # (index_js_url) are the complete, exhaustive list for this theme.
    location /documentation/ {
        sub_filter 'href=/'          'href=/documentation/';
        sub_filter 'src=/'           'src=/documentation/';
        sub_filter 'data-nav-id=/'   'data-nav-id=/documentation/';
        sub_filter 'data-url=/'      'data-url=/documentation/';
        sub_filter 'index_js_url="/' 'index_js_url="/documentation/';
        sub_filter_once off;
        sub_filter_types text/html;
        try_files $uri $uri/ =404;
    }
}
EOF
        # The stock default site also claims `default_server` on port 80
        # - nginx refuses to start with two. Same thing the old, now-
        # retired install_daily.sh used to do by hand.
        rm -f /etc/nginx/sites-enabled/default
        ln -sf "${NGINX_SITE}" /etc/nginx/sites-enabled/pilost

        # Enable and start the service (CPack builds only — debhelper uses #DEBHELPER#)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable ostserver.service
            systemctl start ostserver.service || true
            systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true
        fi
    ;;
esac

#DEBHELPER#
