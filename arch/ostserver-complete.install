# .install scriptlet for the "ostserver-complete" package (issue #230).
#
# Same hands-off philosophy as ostserver.install for the systemd
# service. nginx goes one step further here than the Debian side's
# postinst-complete: Arch's own nginx package ships upstream's stock,
# single-file nginx.conf (no sites-available/sites-enabled convention -
# that is a Debian-specific patch, not present upstream, not on Arch).
# Silently sed-patching a config file we do not package ourselves is
# exactly the kind of system-wide mutation the "hands-off" choice above
# says no to - so this drops an EXAMPLE file instead of a live,
# auto-enabled site, and tells the user the one line to add/copy.

post_install() {
    _configure
    _write_nginx_example
    _hint
}

post_upgrade() {
    _configure
    _write_nginx_example
}

pre_remove() {
    systemctl stop ostserver.service 2>/dev/null || true
    systemctl disable ostserver.service 2>/dev/null || true
}

_configure() {
    INSTALL_USER="${SUDO_USER:-${USER:-root}}"
    USER_HOME=$(getent passwd "${INSTALL_USER}" | cut -d: -f6)
    OST_DIR="${USER_HOME}/.ost"

    sed -i "s/^User=.*/User=${INSTALL_USER}/" /usr/lib/systemd/system/ostserver.service
    sed -i "s|^WorkingDirectory=.*|WorkingDirectory=${OST_DIR}|" /usr/lib/systemd/system/ostserver.service

    mkdir -p "${OST_DIR}"
    chown "${INSTALL_USER}" "${OST_DIR}"

    mkdir -p /var/lib/osterix/media
    chown -R "${INSTALL_USER}" /var/lib/osterix

    PARMS_FILE="${OST_DIR}/ostserver.parms"
    if [ ! -f "${PARMS_FILE}" ]; then
        cp /usr/share/ostserver/ostserver.parms.skel "${PARMS_FILE}"
        chown "${INSTALL_USER}" "${PARMS_FILE}"
    fi

    systemctl daemon-reload
}

_write_nginx_example() {
    mkdir -p /usr/share/doc/ostserver-complete
    cat > /usr/share/doc/ostserver-complete/pilost.conf.example << 'EOF'
server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /var/www/pilost;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /ostmedia/ {
        alias /var/lib/osterix/media/;
        autoindex on;
    }

    location /documentation/ {
        sub_filter 'href=/'          'href=/documentation/';
        sub_filter 'src=/'           'src=/documentation/';
        sub_filter 'data-nav-id=/'   'data-nav-id=/documentation/';
        sub_filter 'data-url=/'      'data-url=/documentation/';
        sub_filter 'index_js_url="/' 'index_js_url="/documentation/';
        sub_filter_once off;
        sub_filter_types text/html;
        try_files $uri $uri/ =404;
    }
}
EOF
}

_hint() {
    echo "==> ostserver-complete is installed but not started/wired (Arch convention)."
    echo "==> Enable and start the backend with:"
    echo "        systemctl enable --now ostserver.service"
    echo "==> An example nginx server block is at:"
    echo "        /usr/share/doc/ostserver-complete/pilost.conf.example"
    echo "    Copy it into /etc/nginx/conf.d/ (create the file, e.g."
    echo "    pilost.conf), make sure /etc/nginx/nginx.conf's http {} block"
    echo "    has 'include /etc/nginx/conf.d/*.conf;', then:"
    echo "        systemctl enable --now nginx.service"
}
