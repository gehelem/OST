#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1

# see FEATURE AREAS in dpkg-buildflags(1)
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
export DEB_CFLAGS_MAINT_APPEND  = -fPIC
# package maintainers to append LDFLAGS
# Note: --no-as-needed is critical: modules are loaded at runtime via QLibrary (dlopen),
# so transitive dependencies must not be stripped at link time.
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--no-as-needed -fPIC


%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure

override_dh_shlibdeps:
	dh_shlibdeps -- -xostserver -xostserver-complete

# NOTE (issue #229): ostserver's own prerm was never wired here before
# this package existed either (no `cp .../prerm debian/ostserver.prerm`
# line previously) - a pre-existing gap (the Launchpad-built "ostserver"
# never stopped/disabled its systemd service on removal, unlike the
# CPack-built one), left alone rather than silently fixed as a drive-by
# change in an unrelated commit. ostserver-complete's own prerm IS wired
# below, correctly, from the start.
execute_before_dh_installdeb:
	cp cmake/cpack/postinst debian/ostserver.postinst
	cp cmake/cpack/complete/postinst debian/ostserver-complete.postinst
	cp cmake/cpack/complete/prerm debian/ostserver-complete.prerm
